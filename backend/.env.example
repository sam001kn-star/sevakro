# Backend Environment Variables Template

# Server Configuration
PORT=5000
NODE_ENV=development
APP_NAME=Sevakro

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/sevakro
# For MongoDB Atlas: MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/sevakro

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRY=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Firebase Configuration (for push notifications)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# Twilio Configuration (for SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# AWS Configuration (for S3 image storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=sevakro-images

# Email Configuration (for notifications)
EMAIL_SERVICE=gmail
EMAIL_USER=noreply@sevakro.com
EMAIL_PASSWORD=your_app_password

# Geospatial Configuration
BOOKING_RADIUS_KM=2

# Error Tracking (Optional)
# SENTRY_DSN=your_sentry_dsn_here

# Logging
LOG_LEVEL=debug
